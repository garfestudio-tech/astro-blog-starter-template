---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>GarFeStudio</h1>
			<p>
				Escaparate personal centrado en piezas técnicas, identidad de marca personalizada,
				merchandising básico y mantenimiento de equipos.
			</p>
			<p>
				Proyecto construido a fuego lento como extensión de mi trayectoria técnica,
				reuniendo fichas, pruebas y notas seleccionadas sin publicar encargos confidenciales.
			</p>
			<ul>
				<li><a href="/blog">Ver fichas y notas</a></li>
				<li><a href="mailto:garfestudio@gmail.com">Contacto: garfestudio@gmail.com</a></li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
