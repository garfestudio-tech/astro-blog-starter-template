---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<p class="eyebrow">Algo Más que RAM · Zona maker</p>
				<h1>GarFeStudio</h1>
				<p class="lead">
					Espacio personal construido como extensión de mi trayectoria técnica,
					proyectos y, por qué no, locuras.
				</p>
			</section>

			<section class="pillars" aria-label="Áreas de trabajo">
				<ul>
					<li>
						<strong>Mis Proyectos . Encargos</strong>
						<span>Proyectos propios y encargos.</span>
					</li>
					<li>
						<strong>Mantenimientos de equipos IT </strong>
						<span>Aunque este blog es MasMaker puedes ver mi trayectoria pulsando en el botón de linkedin.</span>
					</li>
					<li>
						<a href="/locuras" class="pillar-link">
							<strong>Locuras</strong>
							<span>Futura sección de proyectos personales.</span>
						</a>
					</li>
					<li>
						<strong>Encargos</strong>
						<span>Para encargos e información escribid al correo de contacto del pié de página.</span>
					</li>
				</ul>
			</section>

			<div class="actions">
				<a href="/blog" class="btn-primary">Ver proyectos</a>
				<a
					href="https://www.linkedin.com/in/miguelferreirogarcia/"
					target="_blank"
					rel="noopener noreferrer"
					class="btn-secondary"
				>
					Ver perfil en LinkedIn
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		max-width: 780px;
		margin: 0 auto;
		padding: 3.5rem 1.25rem 4rem;
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	h1 {
		margin: 0 0 1rem;
		line-height: 1.1;
	}
	.lead {
		margin: 0;
		font-size: 1.1rem;
		line-height: 1.65;
		color: rgb(var(--gray-dark));
		max-width: 62ch;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin-top: 2rem;
	}
	.btn-primary {
		display: inline-block;
		padding: 0.65rem 1.15rem;
		background: rgb(var(--black));
		color: #fff;
		text-decoration: none;
		border-radius: 10px;
		font-weight: 600;
	}
	.btn-primary:hover {
		opacity: 0.9;
	}
	.btn-secondary {
		display: inline-block;
		padding: 0.65rem 1.15rem;
		color: rgb(var(--gray-dark));
		background: transparent;
		border: 1px solid rgba(var(--gray), 0.45);
		border-radius: 10px;
		text-decoration: none;
		font-weight: 600;
	}
	.btn-secondary:hover {
		color: rgb(var(--black));
		border-color: rgb(var(--black));
	}
	.pillars {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(var(--gray), 0.25);
	}
	.pillars ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem 1.5rem;
	}
	.pillars li {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.85rem 1rem;
		border: 1px solid rgba(var(--gray), 0.22);
		border-radius: 14px;
		background: rgba(var(--gray-light), 0.35);
	}
	.pillars li:has(.pillar-link) {
		padding: 0;
	}
	.pillar-link {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.85rem 1rem;
		text-decoration: none;
		color: inherit;
		border-radius: 14px;
	}
	.pillar-link:hover strong {
		text-decoration: underline;
	}
	.pillars strong {
		color: rgb(var(--black));
		font-size: 0.98rem;
	}
	.pillars span {
		color: rgb(var(--gray-dark));
		font-size: 0.9rem;
		line-height: 1.45;
	}
	@media (max-width: 640px) {
		.home {
			padding-top: 2.25rem;
		}
		.pillars ul {
			grid-template-columns: 1fr;
		}
	}
</style>
