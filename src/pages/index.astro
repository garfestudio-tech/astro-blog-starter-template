---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<p class="eyebrow">Algo Más que RAM · Zona maker</p>
				<div class="hero-title">
					<svg
						class="hero-mark"
						width="44"
						height="44"
						viewBox="0 0 24 24"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						aria-hidden="true"
					>
						<path
							d="M11.5 6.5H6.5C5.11929 6.5 4 7.61929 4 9V15C4 16.3807 5.11929 17.5 6.5 17.5H9.5C10.8807 17.5 12 16.3807 12 15V12.5H8.5"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
						<path
							d="M14.5 17.5V6.5H20M14.5 12H18.5"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
						<circle cx="20" cy="12" r="1.5" fill="currentColor" />
					</svg>
					<h1>GarFeStudio</h1>
				</div>
				<p class="lead">
					Espacio personal construido como extensión de mi trayectoria técnica,
					proyectos y, por qué no, locuras.
				</p>
			</section>

			<section class="pillars" aria-label="Áreas de trabajo">
				<ul>
					<li>
						<a href="/blog" class="pillar-link">
							<strong>Mis Proyectos . Encargos</strong>
							<span>Proyectos propios y encargos.</span>
						</a>
					</li>
					<li>
						<a
							href="https://www.linkedin.com/in/miguelferreirogarcia/"
							target="_blank"
							rel="noopener noreferrer"
							class="pillar-link"
						>
							<strong>Mantenimientos de equipos IT</strong>
							<span>Aunque este blog es MasMaker puedes ver mi trayectoria pulsando aquí o en LinkedIn.</span>
						</a>
					</li>
					<li>
						<a href="/locuras" class="pillar-link">
							<strong>Locuras</strong>
							<span>Futura sección de proyectos personales.</span>
						</a>
					</li>
					<li>
						<strong>Encargos</strong>
						<span>Para encargos e información escribid al correo de contacto del pié de página.</span>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		max-width: 780px;
		margin: 0 auto;
		padding: 3.5rem 1.25rem 4rem;
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.hero-title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 1rem;
	}
	.hero-mark {
		flex-shrink: 0;
		color: rgb(var(--black));
	}
	h1 {
		margin: 0;
		line-height: 1.1;
	}
	.lead {
		margin: 0;
		font-size: 1.1rem;
		line-height: 1.65;
		color: rgb(var(--gray-dark));
		max-width: 62ch;
	}
	.pillars {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(var(--gray), 0.25);
	}
	.pillars ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem 1.5rem;
	}
	.pillars li {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.85rem 1rem;
		border: 1px solid rgba(var(--gray), 0.22);
		border-radius: 14px;
		background: rgba(var(--gray-light), 0.35);
	}
	.pillars li:has(.pillar-link) {
		padding: 0;
	}
	.pillar-link {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.85rem 1rem;
		text-decoration: none;
		color: inherit;
		border-radius: 14px;
	}
	.pillar-link:hover strong {
		text-decoration: underline;
	}
	.pillars strong {
		color: rgb(var(--black));
		font-size: 0.98rem;
	}
	.pillars span {
		color: rgb(var(--gray-dark));
		font-size: 0.9rem;
		line-height: 1.45;
	}
	@media (max-width: 640px) {
		.home {
			padding-top: 2.25rem;
		}
		.hero-mark {
			width: 34px;
			height: 34px;
		}
		.pillars ul {
			grid-template-columns: 1fr;
		}
	}
</style>
