---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const ejemplos = [
	{
		imagen: '/proyectos/ejemplo-1.jpg',
		alt: 'Muestra visual de pieza técnica en banco de pruebas',
		titulo: 'Pieza técnica de banco',
		descripcion: 'Montaje y ajuste práctico en el taller.',
		enlace: '/blog',
		textoEnlace: 'Ver detalle',
	},
	{
		imagen: '/proyectos/ejemplo-2.jpg',
		alt: 'Prueba de identidad visual aplicada a soporte',
		titulo: 'Prueba de identidad',
		descripcion: 'Ensayo sobrio de aplicación gráfica a medida.',
		enlace: '/about',
		textoEnlace: 'Ver contexto',
	},
	{
		imagen: '/proyectos/ejemplo-3.jpg',
		alt: 'Boceto de montaje maker en fase inicial',
		titulo: 'Nota de taller',
		descripcion: 'Avance inicial a fuego lento.',
		enlace: '/locuras',
		textoEnlace: 'Explorar más',
	},
	{
		imagen: '/proyectos/ejemplo-4.jpg',
		alt: 'Revisión y puesta a punto de equipo',
		titulo: 'Puesta a punto',
		descripcion: 'Revisión limpia y cuidado continuo.',
		enlace: '/',
		textoEnlace: 'Ir al inicio',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Proyectos | ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
		/>
		<style>
			.projects-main {
				max-width: 960px;
				margin: 0 auto;
				padding: 3.5rem 1.25rem 4rem;
			}
			.section-header {
				margin-bottom: 2.25rem;
			}
			.section-header h1 {
				margin: 0 0 0.5rem 0;
				line-height: 1.1;
			}
			.section-header p {
				margin: 0;
				color: rgb(var(--gray-dark));
				line-height: 1.6;
			}
			.gallery-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.75rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.project-card {
				display: flex;
				flex-direction: column;
				height: 100%;
				border: 1px solid rgba(var(--gray), 0.22);
				border-radius: 14px;
				overflow: hidden;
				background: rgba(var(--gray-light), 0.35);
			}
			.project-thumb {
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: rgba(var(--gray), 0.12);
			}
			.project-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				border-radius: 0;
			}
			.project-body {
				display: flex;
				flex-direction: column;
				flex: 1;
				padding: 1rem 1.15rem 1.2rem;
				gap: 0.45rem;
			}
			.project-body h2 {
				margin: 0;
				font-size: 1.08rem;
				line-height: 1.3;
				color: rgb(var(--black));
			}
			.project-body p {
				margin: 0;
				font-size: 0.92rem;
				line-height: 1.5;
				color: rgb(var(--gray-dark));
				flex: 1;
			}
			.project-link {
				align-self: flex-start;
				margin-top: 0.4rem;
				color: rgb(var(--black));
				font-size: 0.9rem;
				font-weight: 600;
				text-decoration: none;
				border-bottom: 1px solid rgba(var(--gray), 0.5);
				padding-bottom: 0.1rem;
			}
			.project-link:hover {
				border-bottom-color: rgb(var(--black));
			}
			@media (max-width: 640px) {
				.projects-main {
					padding-top: 2.25rem;
				}
				.gallery-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="projects-main">
			<div class="section-header">
				<h1>Proyectos</h1>
				<p>Selección visual a fuego lento, sin prisas ni relleno.</p>
			</div>

			<section aria-label="Galería de proyectos">
				<ul class="gallery-grid">
					{
						ejemplos.map((item) => (
							<li>
								<article class="project-card">
									<div class="project-thumb">
										<img
											src={item.imagen}
											alt={item.alt}
											loading="lazy"
										/>
									</div>
									<div class="project-body">
										<h2>{item.titulo}</h2>
										<p>{item.descripcion}</p>
										<a href={item.enlace} class="project-link">
											{item.textoEnlace} →
										</a>
									</div>
								</article>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
