---
const today = new Date();
---

<footer>
	<p class="footer-copy">
		&copy; {today.getFullYear()} GarFeStudio. Todos los derechos reservados.
	</p>
	<p class="footer-contact">
		<a href="mailto:garfestudio@gmail.com">garfestudio@gmail.com</a>
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-copy {
		margin: 0;
	}
	.footer-contact {
		margin: 0.5em 0 0 0;
	}
	.footer-contact a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.footer-contact a:hover {
		color: rgb(var(--gray-dark));
		text-decoration: underline;
	}
</style>
