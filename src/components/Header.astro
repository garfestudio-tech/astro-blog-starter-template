---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2>
			<a href="/" class="brand">
				<svg
					class="brand-mark"
					width="22"
					height="22"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<!-- G con remate de ajuste -->
					<path
						d="M11.5 6.5H6.5C5.11929 6.5 4 7.61929 4 9V15C4 16.3807 5.11929 17.5 6.5 17.5H9.5C10.8807 17.5 12 16.3807 12 15V12.5H8.5"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
					<!-- F unida en el eje central -->
					<path
						d="M14.5 17.5V6.5H20M14.5 12H18.5"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
					<!-- Punto de anclaje / detalle maker -->
					<circle cx="20" cy="12" r="1.5" fill="currentColor" />
				</svg>
				<span>{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/blog">Proyectos</HeaderLink>
			<HeaderLink href="/locuras">Locuras</HeaderLink>
			<HeaderLink href="/about">Sobre mi</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.brand-mark {
		flex-shrink: 0;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
